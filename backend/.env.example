PORT=3001

DATABASE_URL="postgresql://cmh_app:MOT_DE_PASSE@localhost:5432/cmh_academy_dev"
SHADOW_DATABASE_URL="postgresql://cmh_app:MOT_DE_PASSE@localhost:5432/cmh_academy_shadow"
# Secret serveur aleatoire, au moins 32 caracteres ; ne pas versionner sa valeur.
SESSION_SECRET=
# Origines exactes autorisees. En production : HTTPS obligatoire.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Derriere un proxy HTTPS connu uniquement (exemple : loopback).
TRUSTED_PROXY=
# Stockage prive des pieces jointes, relatif au dossier backend ou chemin absolu.
DOCUMENT_STORAGE_DIR=.private-documents
# 10 Mo binaires par fichier.
DOCUMENT_MAX_FILE_BYTES=10485760
# MP4 H.264 yuv420p + AAC facultatif, faststart. 512 Mio par défaut, maximum 2 Gio - 1.
VIDEO_MAX_FILE_BYTES=536870912
# ffprobe système maintenu (6.1+), facultatif si disponible dans PATH.
# Aucun binaire d'analyse n'est embarqué dans les dépendances de production.
VIDEO_FFPROBE_PATH=
